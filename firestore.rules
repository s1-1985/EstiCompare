rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Safety Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // 3. Entity Specific Validations
    function isValidScenario(data) {
      return data.id is string && data.id.size() <= 128
        && data.userId == request.auth.uid
        && data.name is string && data.name.size() <= 256
        && data.newEstimate is map
        && data.oldEstimate is map;
    }

    // 4. Scenarios Collection Rules
    match /scenarios/{scenarioId} {
      allow create: if isSignedIn()
        && isEmailVerified()
        && isValidId(scenarioId)
        && isValidScenario(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isEmailVerified()
        && isValidScenario(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isSignedIn()
        && isEmailVerified()
        && existing().userId == request.auth.uid;

      allow get: if isSignedIn()
        && existing().userId == request.auth.uid;

      allow list: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }
  }
}
